# Runtime
NODE_ENV=development
PORT=3000
API_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=0
BUILD_SHA=development

# Browser boundary. Keep empty until the Web Admin origin exists.
CORS_ALLOWED_ORIGINS=
WEB_ALLOWED_RETURN_URLS=http://localhost:5173
REQUEST_BODY_LIMIT=1mb

# Infrastructure
DATABASE_URL=postgresql://autobot:autobot@localhost:5432/autobot?schema=public&connect_timeout=5
REDIS_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=autobot:development
DB_POOL_MAX=10

# Local ephemeral image processing
IMAGE_TEMP_DIR=.tmp/images
IMAGE_TEMP_TTL_SECONDS=3600
IMAGE_MAX_BYTES=10485760
IMAGE_TEMP_MAX_TOTAL_BYTES=524288000

# Telegram browser login. Leave credentials empty until configured in BotFather.
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
# Example: http://localhost:3000/api/v1/auth/telegram/callback
TELEGRAM_OIDC_REDIRECT_URI=
TELEGRAM_OIDC_SCOPES=openid profile
OIDC_FLOW_TTL_SECONDS=600
OIDC_REQUEST_TIMEOUT_MS=10000

# Telegram Bot API. Required in production for channel validation and publication.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_API_TIMEOUT_MS=10000

# Browser sessions
SESSION_COOKIE_NAME=__Host-autobot_session
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=true

# Bot HMAC authentication. Use a separate secret of at least 32 random bytes.
BOT_SERVICE_ACTIVE_KEY_ID=
BOT_SERVICE_ACTIVE_SECRET=
BOT_SERVICE_PREVIOUS_KEY_ID=
BOT_SERVICE_PREVIOUS_SECRET=
BOT_SERVICE_CLOCK_SKEW_SECONDS=60
BOT_SERVICE_NONCE_TTL_SECONDS=300

# Authentication endpoint rate limit
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Queues and scheduling
QUEUE_PREFIX=autobot:development
GENERATION_CONCURRENCY=2
PUBLICATION_CONCURRENCY=2
OUTBOX_POLL_INTERVAL_MS=1000
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_LOOKAHEAD_SECONDS=300
PUBLICATION_MAX_ATTEMPTS=5
